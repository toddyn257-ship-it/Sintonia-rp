                    while tick() - startT < DELIVER_WAIT do
                        task.wait(0.2)
                        if not Config.Lixo.Enabled then break end
                        if LixoIsGone(DELIVERY_POSITION, target) then success = true; break end
                    end
                    if success then break end
                else
                    LixoUpdateStatus("🖱️ Clicando na caçamba (" .. attempt .. "/5)...")
                    local vs = Camera.ViewportSize
                    LixoClickMouse(vs.X / 2, vs.Y / 2)
                    task.wait(DELIVER_WAIT)
                    success = true
                    break
                end
                task.wait(0.5)
            end

            if success and Config.Lixo.Enabled then
                LixoUpdateStatus("✅ Entregue! Reiniciando...")
                Config.Lixo.Coletados = 0
                LixoIgnored = {}
                task.wait(2)
            else
                task.wait(2)
            end
            continue
        end

        -- COLETA (ignorando os que foram pulados)
        local nearest, nearestTarget, nearestType = nil, nil, nil
        local nearestIndex = nil
        local nearestDist = math.huge
        for i, pos in ipairs(LIXO_POSITIONS) do
            if not LixoIgnored[pos] then
                local dist = (hrp.Position - pos).Magnitude
                if dist < nearestDist then
                    local target, targetType = LixoFindInteractive(pos, 12)
                    if target and LixoIsPathClear(hrp.Position, pos) then
                        nearest, nearestTarget, nearestType, nearestDist, nearestIndex = pos, target, targetType, dist, i
                    end
                end
            end
        end

        if not nearest then
            local totalIgnored = 0
            for _ in pairs(LixoIgnored) do totalIgnored = totalIgnored + 1 end
            if totalIgnored >= #LIXO_POSITIONS then
                LixoIgnored = {}
                LixoUpdateStatus("🔄 Todos pulados! Reiniciando...")
                task.wait(1)
                continue
            else
                LixoUpdateStatus("❌ Nenhum lixo disponível")
                task.wait(1)
                continue
            end
        end

        CurrentLixoIndex = nearestIndex

        -- ✅ Ir até o lixo COM verificação de skip DENTRO do loop
        LixoUpdateStatus("🚶 Indo até o lixo...")
        hum:MoveTo(nearest)
        local timeout = tick() + 20
        local skipped = false
        while tick() < timeout do
            task.wait(0.2)

            -- ✅ Se desativou, para tudo
            if not Config.Lixo.Enabled then
                hum:MoveTo(hrp.Position)
                skipped = true
                break
            end

            -- ✅ Se clicou em "Próximo Lixo", para e ignora
            if SkipCurrentLixoRequest then
                SkipCurrentLixoRequest = false
                LixoIgnored[nearest] = true
                hum:MoveTo(hrp.Position)
                LixoUpdateStatus("⏭️ Lixo pulado!")
                CurrentLixoIndex = nil
                skipped = true
                break
            end

            if (hrp.Position - nearest).Magnitude <= 4 then break end
            if hum.MoveDirection.Magnitude < 0.1 then hum:MoveTo(nearest) end
        end

        if skipped then
            task.wait(0.3)
            continue
        end

        if (hrp.Position - nearest).Magnitude > 6 then
            LixoUpdateStatus("⚠️ Não conseguiu chegar")
            LixoIgnored[nearest] = true
            task.wait(1)
            continue
        end

        hum:MoveTo(hrp.Position)
        LixoWaitForHumanoid()
        LixoUpdateStatus("🖐️ Coletando...")

        local collected = false
        for attempt = 1, 3 do
            if not Config.Lixo.Enabled then break end
            local target, targetType = LixoFindInteractive(nearest, 12)
            if not target then collected = true; break end
            LixoSafeInteract(target, targetType)
            LixoUpdateStatus("⏳ Coletando (" .. attempt .. "/3)...")
            local startT = tick()
            while tick() - startT < COLLECT_WAIT do
                task.wait(0.15)
                if not Config.Lixo.Enabled then break end
                if LixoIsGone(nearest, target) then collected = true; break end
            end
            if collected then break end
            task.wait(0.3)
        end

        if not collected and Config.Lixo.Enabled then
            task.wait(0.5)
            local stillThere = LixoFindInteractive(nearest, 10)
            if not stillThere then collected = true end
        end

        if collected and Config.Lixo.Enabled then
            Config.Lixo.Coletados = Config.Lixo.Coletados + 1
            LixoUpdateStatus("✅ Coletado! (" .. Config.Lixo.Coletados .. "/" .. Config.Lixo.MaxColetas .. ")")
            task.wait(0.3)
        elseif Config.Lixo.Enabled then
            LixoUpdateStatus("⚠️ Coleta falhou, pulando...")
            LixoIgnored[nearest] = true
            task.wait(0.5)
        end
    end
end)

