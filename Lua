-- AIMBOT LOGIC
local function shouldReleaseLock(player)
    if not player or not player.Parent then return true end
    if player == LocalPlayer then return true end
    if isTeammateOf(player, Config.Aimbot.TeamCheck) then return true end
    if not player.Character then return true end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return true end
    return false
end

local function canAimAt(player)
    if not player or not player.Character then return false, nil end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false, nil end
    local part = getAimbotTargetPart(player.Character)
    if not part then return false, nil end
    return true, part
end

local function findNewTarget(myRoot, excludePlayer, mode)
    mode = mode or "default"
    local candidates = {}
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player ~= excludePlayer and player.Character then
            if not isTeammateOf(player, Config.Aimbot.TeamCheck) then
                local char = player.Character
                local hum  = char:FindFirstChildOfClass("Humanoid")
                local part = getAimbotTargetPart(char)
                if part and hum and hum.Health > 0 then
                    local dist = (part.Position - myRoot.Position).Magnitude
                    if not (Config.Aimbot.LimitToDistance and dist > Config.Aimbot.MaxDistance) then
                        local scrPos   = getScreenInfo(part)
                        local onScreen = scrPos ~= nil
                        local inFOV    = false
                        if onScreen then inFOV = (scrPos - center).Magnitude <= Config.Aimbot.FOV end
                        local passFOV = (mode == "hidden") or (not Config.Aimbot.FOVAffectsAim) or inFOV
                        if passFOV then
                            local needLoS = (mode == "visible" and Config.Aimbot.VisibleOnly) or (mode == "default")
                            local los = needLoS and isVisible(part) or nil
                            table.insert(candidates, { player = player, dist = dist, onScreen = onScreen, los = los })
                        end
                    end
                end
            end
        end
    end
    if #candidates == 0 then return nil end
    if mode == "hidden" then
        local hiddenList = {}
        for _, c in ipairs(candidates) do if not c.onScreen then table.insert(hiddenList, c) end end
        local pool = (#hiddenList > 0) and hiddenList or candidates
        table.sort(pool, function(a, b) return a.dist < b.dist end)
        return pool[1].player
    end
    if mode == "visible" then
        local visList = {}
        for _, c in ipairs(candidates) do
            if c.onScreen and (not Config.Aimbot.VisibleOnly or c.los) then table.insert(visList, c) end
        end
        if #visList > 0 then table.sort(visList, function(a, b) return a.dist < b.dist end) return visList[1].player end
        return nil
    end
    if Config.Aimbot.VisibleOnly then
        local visList = {}
        for _, c in ipairs(candidates) do if c.los then table.insert(visList, c) end end
        table.sort(visList, function(a, b) return a.dist < b.dist end)
        return visList[1] and visList[1].player or nil
    else
        table.sort(candidates, function(a, b) return a.dist < b.dist end)
        return candidates[1].player
    end
end

local lastLockShown = nil
RunService.RenderStepped:Connect(function()
    if not Config.Aimbot.Enabled then return end
    if Config.Aimbot.HotkeyEnabled and not aimbotHolding then return end
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
