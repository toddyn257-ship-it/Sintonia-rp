local function LixoIsPathClear(fromPos, toPos)
    if not Config.Lixo.CheckWall then return true end
    local char = LocalPlayer.Character if not char then return false end
    local direction = toPos - fromPos
    if direction.Magnitude <= 0 then return true end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {char, Camera}
    rp.IgnoreWater = true
    local result = workspace:Raycast(fromPos, direction.Unit * direction.Magnitude, rp)
    if result and result.Instance.Transparency < 0.5 and result.Instance.CanCollide then return false end
    return true
end

local function LixoFindInteractive(position, radius)
    radius = radius or 12
    local best, bestDist, bestType = nil, radius, nil
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local parent = obj.Parent
            if parent then
                local pp
                if parent:IsA("BasePart") then pp = parent.Position
                else local p = parent:FindFirstChildWhichIsA("BasePart"); if p then pp = p.Position end end
                if pp then
                    local dist = (pp - position).Magnitude
                    if dist < bestDist then bestDist = dist; best = obj; bestType = "prompt" end
                end
            end
        end
    end
    if not best then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ClickDetector") then
                local parent = obj.Parent
                if parent and parent:IsA("BasePart") then
                    local dist = (parent.Position - position).Magnitude
                    if dist < bestDist then bestDist = dist; best = obj; bestType = "click" end
                end
            end
        end
    end
    return best, bestType
end

local function LixoSafeInteract(target, targetType)
    local vs = Camera.ViewportSize
    local success = false
    if targetType == "prompt" then
        success = pcall(function()
            target:InputHoldBegin()
            task.wait(target.HoldDuration > 0 and target.HoldDuration or 0.2)
            target:InputHoldEnd()
        end)
        if not success then success = pcall(function() fireproximityprompt(target) end) end
        if not success then
            pcall(function()
                UserInputService:SendMouseButton(Vector2.new(vs.X/2, vs.Y/2), Enum.UserInputType.MouseButton1, true)
                task.wait(0.08)
                UserInputService:SendMouseButton(Vector2.new(vs.X/2, vs.Y/2), Enum.UserInputType.MouseButton1, false)
            end)
            success = true
        end
    elseif targetType == "click" then
        success = pcall(function() fireclickdetector(target) end)
        if not success then
            pcall(function()
                UserInputService:SendMouseButton(Vector2.new(vs.X/2, vs.Y/2), Enum.UserInputType.MouseButton1, true)
                task.wait(0.08)
                UserInputService:SendMouseButton(Vector2.new(vs.X/2, vs.Y/2), Enum.UserInputType.MouseButton1, false)
            end)
            success = true
        end
    else
        pcall(function()
            UserInputService:SendMouseButton(Vector2.new(vs.X/2, vs.Y/2), Enum.UserInputType.MouseButton1, true)
            task.wait(0.08)
            UserInputService:SendMouseButton(Vector2.new(vs.X/2, vs.Y/2), Enum.UserInputType.MouseButton1, false)
        end)
        success = true
    end
    return success
end

