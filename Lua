local function getAimbotTargetPart(character)
    if not character then return nil end
    if Config.Aimbot.TargetPart == "Head" then return character:FindFirstChild("Head")
    elseif Config.Aimbot.TargetPart == "Torso" then
        return character:FindFirstChild("UpperTorso") or character:FindFirstChild("LowerTorso")
            or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
    end
    return character:FindFirstChild(Config.Aimbot.TargetPart)
end

local function isTeammateOf(player, checkEnabled)
    if not checkEnabled then return false end
    if player == LocalPlayer then return false end
    local lt, pt = LocalPlayer.Team, player.Team
    if not lt or not pt then return false end
    return lt == pt
end

local function isVisible(targetPart)
    if not targetPart then return false end
    local origin    = Camera.CFrame.Position
    local targetPos = targetPart.Position
    local excluded  = { LocalPlayer.Character, targetPart.Parent }
    for _ = 1, 3 do
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = excluded
        rp.IgnoreWater = true
        local result = workspace:Raycast(origin, targetPos - origin, rp)
        if not result then return true end
        local hit = result.Instance
        if hit.Transparency >= 0.8 or not hit.CanCollide then table.insert(excluded, hit)
        else return false end
    end
    return false
end

local function getScreenInfo(targetPart)
    if not targetPart then return nil end
    local pos, on = Camera:WorldToViewportPoint(targetPart.Position)
    if not on or pos.Z <= 0 then return nil end
    return Vector2.new(pos.X, pos.Y)
end

local function getPredictedPosition(part, myPos)
    if not Config.Aimbot.PredictionEnabled then return part.Position end
    if not part then return nil end
    local char = part.Parent
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return part.Position end
    local vel = root.AssemblyLinearVelocity
    if vel.Magnitude < 1 then return part.Position end
    local dist = (part.Position - myPos).Magnitude
    local bulletSpeed = math.max(Config.Aimbot.BulletSpeed, 1)
    return part.Position + (vel * (dist / bulletSpeed) * Config.Aimbot.PredictionMultiplier)
end

local function makeDraggable(frame, dragArea)
    local dragging, dragStart, startPos = false, nil, nil
    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, input.Position, frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

local function isHeldKey(input)
    local key = Config.Aimbot.HotkeyKey
    if key == "MouseButton2" then return input.UserInputType == Enum.UserInputType.MouseButton2
    elseif key == "MouseButton1" then return input.UserInputType == Enum.UserInputType.MouseButton1
    elseif key == "E" then return input.KeyCode == Enum.KeyCode.E
    elseif key == "Q" then return input.KeyCode == Enum.KeyCode.Q
    elseif key == "Shift" then return input.KeyCode == Enum.KeyCode.LeftShift end
    return false
end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if isHeldKey(input) then aimbotHolding = true end
end)
UserInputService.InputEnded:Connect(function(input)
    if isHeldKey(input) then aimbotHolding = false end
end)

