    end

    if not Config.Aimbot.LockedTarget then
        Config.Aimbot.LockedTarget = Config.Aimbot.Unfocused and findNewTarget(myRoot, nil, "visible") or findNewTarget(myRoot, nil, "default")
    end

    if Config.Aimbot.LockedTarget ~= lastLockShown then
        lastLockShown = Config.Aimbot.LockedTarget
        updateFloatingTarget()
    end

    local locked = Config.Aimbot.LockedTarget
    if not locked then return end
    local canAim, part = canAimAt(locked)
    if not canAim then return end
    if Config.Aimbot.LimitToDistance and (part.Position - myRoot.Position).Magnitude > Config.Aimbot.MaxDistance then return end
    if Config.Aimbot.VisibleOnly and not isVisible(part) then return end

    local aimPos = getPredictedPosition(part, Camera.CFrame.Position)
    if not aimPos then return end

    local goal  = CFrame.new(Camera.CFrame.Position, aimPos)
    local alpha = math.clamp(Config.Aimbot.Sensitivity * Config.Aimbot.Strength, 0, 1)
    Camera.CFrame = Camera.CFrame:Lerp(goal, alpha)
end)

-- ESP TRACKER
local espDrawings = {}

local function clearDrawings(player)
    if espDrawings[player] then
        for _, d in pairs(espDrawings[player]) do
            if d and d.Remove then pcall(function() d:Remove() end) end
        end
        espDrawings[player] = nil
    end
    if player.Character then
        for _, obj in ipairs(player.Character:GetChildren()) do
            if obj:IsA("Highlight") then obj:Destroy() end
        end
    end
end

local function updateESP()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if isTeammateOf(player, Config.ESP.TeamCheck) then clearDrawings(player); continue end
        local char = player.Character
        if not char then clearDrawings(player); continue end

        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not (root and head and hum) then clearDrawings(player); continue end

        local dist = (root.Position - myRoot.Position).Magnitude
        if dist > Config.ESP.MaxDistance then clearDrawings(player); continue end
        if not Config.ESP.ThroughWalls and not isVisible(head) then clearDrawings(player); continue end

        local d = espDrawings[player] or {}
        espDrawings[player] = d

        local topPos, topOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local bottomPos, bottomOn = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))

        if topOn and bottomOn then
            local height = math.abs(bottomPos.Y - topPos.Y)
            local width = height * 0.5
            local x = topPos.X - width / 2
            local y = topPos.Y

            if Config.ESP.Highlight then
                if not d.highlightFill then
                    d.highlightFill = Drawing.new("Square")
                    d.highlightFill.Filled = true
                    d.highlightFill.Thickness = 0
                end
                local transp = math.clamp((1 - Config.ESP.HighlightIntensity) * 0.8 + 0.15, 0.1, 0.85)
                d.highlightFill.Color = Config.ESP.HighlightColor
                d.highlightFill.Transparency = transp
                d.highlightFill.Size = Vector2.new(width + 4, height + 4)
                d.highlightFill.Position = Vector2.new(x - 2, y - 2)
                d.highlightFill.Visible = true

                if not d.highlightOutline then
                    d.highlightOutline = Drawing.new("Square")
                    d.highlightOutline.Filled = false
                end
                d.highlightOutline.Color = Config.ESP.HighlightColor
                d.highlightOutline.Thickness = Config.ESP.HighlightThickness
                d.highlightOutline.Transparency = 1
                d.highlightOutline.Size = Vector2.new(width + 4, height + 4)
                d.highlightOutline.Position = Vector2.new(x - 2, y - 2)
                d.highlightOutline.Visible = true
            else
                if d.highlightFill then d.highlightFill.Visible = false end
                if d.highlightOutline then d.highlightOutline.Visible = false end
            end

            if Config.ESP.Box then
                if not d.box then
                    d.box = Drawing.new("Square")
                    d.box.Thickness = 1
                    d.box.Filled = false
                end
                d.box.Color = Config.ESP.BoxColor
                d.box.Size = Vector2.new(width, height)
                d.box.Position = Vector2.new(x, y)
                d.box.Visible = true
            elseif d.box then
                d.box.Visible = false
            end

            if Config.ESP.Lines then
                if not d.line then
                    d.line = Drawing.new("Line")
                    d.line.Thickness = 1
                end
                d.line.Color = Config.ESP.LinesColor
                d.line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                d.line.To = Vector2.new(topPos.X, topPos.Y + height / 2)
                d.line.Visible = true
            elseif d.line then
                d.line.Visible = false
            end

            if Config.ESP.Health then
                if not d.health then
                    d.health = Drawing.new("Square")
                    d.health.Thickness = 2
                    d.health.Filled = true
                end
                local hpPct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                local hpHeight = height * hpPct
                d.health.Size = Vector2.new(4, hpHeight)
                d.health.Position = Vector2.new(x - 8, y + (height - hpHeight))
                d.health.Color = Color3.fromRGB(255 * (1 - hpPct), 255 * hpPct, 0)
                d.health.Visible = true
            elseif d.health then
                d.health.Visible = false
            end

            if Config.ESP.ShowName or Config.ESP.ShowDistance then
                if not d.text then
                    d.text = Drawing.new("Text")
                    d.text.Size = 14
                    d.text.Center = true
                    d.text.Outline = true
                    d.text.OutlineColor = Color3.fromRGB(0, 0, 0)
                    d.text.Color = Color3.fromRGB(255, 255, 255)
                    d.text.Font = 2
                end
                local parts = {}
                if Config.ESP.ShowName then table.insert(parts, player.Name) end
                if Config.ESP.ShowDistance then table.insert(parts, math.floor(dist) .. "m") end
                d.text.Text = table.concat(parts, " | ")
                d.text.Position = Vector2.new(topPos.X, y - Config.ESP.TextHeightOffset)
                d.text.Visible = true
            elseif d.text then
                d.text.Visible = false
            end
        else
            if d.highlightFill then d.highlightFill.Visible = false end
            if d.highlightOutline then d.highlightOutline.Visible = false end
            if d.box then d.box.Visible = false end
            if d.line then d.line.Visible = false end
            if d.health then d.health.Visible = false end
            if d.text then d.text.Visible = false end
        end
    end
end

RunService.RenderStepped:Connect(function()
    pcall(updateESP)
end)

