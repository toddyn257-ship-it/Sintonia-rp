local StaffDetector = { ScanInterval = 2 }
local SUSPICIOUS_KEYWORDS = { "staff", "admin", "mod", "moderador", "moderator", "owner", "dono", "fundador", "founder", "gerente", "manager", "suporte", "support", "ceo", "dev", "developer", "gm", "supervisor", "coordenador", "helper", "moderacao", "moderação", "adm", "adml", "adms", "admins", "staffs", "staffteam" }
local EXACT_WORDS = { ["staff"] = true, ["admin"] = true, ["mod"] = true, ["moderator"] = true, ["owner"] = true, ["adm"] = true, ["gm"] = true }

local function GetTeamName(player)
    local team = player.Team
    if team then return team.Name end
    local char = player.Character
    if char then
        local tv = char:FindFirstChild("Team") or char:FindFirstChild("TeamValue")
        if tv then return tostring(tv.Value) end
    end
    return ""
end

local function HasSuspiciousName(name)
    local ln = string.lower(name)
    for word in string.gmatch(ln, "%a+") do if EXACT_WORDS[word] then return true, word end end
    for _, kw in ipairs(SUSPICIOUS_KEYWORDS) do
        if string.find(ln, "^" .. kw) or string.find(ln, kw .. "$") or string.find(ln, "%s" .. kw .. "%s") then return true, kw end
    end
    return false, nil
end

local function AnalyzePlayer(p)
    if p == LocalPlayer then return nil end
    local reasons, score = {}, 0
    local h1, k1 = HasSuspiciousName(p.Name)
    if h1 then score = score + 5; table.insert(reasons, "Palavra no nome: '" .. k1 .. "'") end
    local h2, k2 = HasSuspiciousName(p.DisplayName)
    if h2 then score = score + 5; table.insert(reasons, "Palavra no DisplayName: '" .. k2 .. "'") end
    if p.Team then
        local tn = string.lower(p.Team.Name)
        for word in string.gmatch(tn, "%a+") do
            if EXACT_WORDS[word] then score = score + 8; table.insert(reasons, "Time: '" .. p.Team.Name .. "'"); break end
        end
    end
    if p.Character then
        local hum = p.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed > 100 then score = score + 4; table.insert(reasons, "Speed: " .. hum.WalkSpeed) end
    end
    if score < 10 then return nil end
    local risk = "low"
    if score >= 20 then risk = "high" elseif score >= 13 then risk = "medium" end
    return { player = p, score = score, risk = risk, reasons = reasons, team = GetTeamName(p), displayName = p.DisplayName, username = p.Name, userId = p.UserId }
end

